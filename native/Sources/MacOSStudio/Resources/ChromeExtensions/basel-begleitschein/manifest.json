{
  "manifest_version": 3,
  "name": "Basel Begleitschein",
  "version": "1.3.1",
  "description": "Erstellt das Basel Movement Document als PDF – mit aktuellem Datum, Name und Unterschrift der gewählten Person.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Basel-Dokument erstellen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}