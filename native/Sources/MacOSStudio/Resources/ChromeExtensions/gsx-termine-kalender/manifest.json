{
  "manifest_version": 3,
  "name": "GSX Termine → Kalender",
  "version": "1.2.1",
  "description": "Liest Termine aus GSX und exportiert sie mit Vor- und Nachnamen in den Apple Kalender.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "downloads.open",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "GSX-Termine exportieren",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png"
    }
  },
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
